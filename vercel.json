{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/generate-qr",
      "destination": "/api/generate-qr.js"
    },
    {
      "source": "/api/check-status",
      "destination": "/api/check-status.js"
    },
    {
      "source": "/api/check-status/:qrId",
      "destination": "/api/check-status.js?qrId=:qrId"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/:match*",
      "destination": "/public/:match*"
    }
  ]
}
